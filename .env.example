# Required in BOTH standalone and Coolify use, but each environment needs a DIFFERENT real
# value — the defaults below are the standalone file's bundled-Postgres/bundled-Valkey
# credentials only. For Coolify, these same three var NAMES must be set again as real Coolify
# env vars holding the shared Postgres's dedicated `n8n_user` credentials (POSTGRES_USER/
# POSTGRES_PASSWORD) and the shared Valkey ACL user's own password (VALKEY_PASSWORD) — do NOT
# carry these placeholder values into the Coolify deploy, `docker-compose.coolify.yaml` hard-
# fails on an unset var but NOT on a deliberately-copied placeholder one:
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=n8n
POSTGRES_DB=n8n
VALKEY_PASSWORD=n8n

# Required in both standalone and Coolify use — no default, deploy fails loudly without it:
# - Standalone: http://localhost:5678
# - Coolify: the real public domain, e.g. https://sub.domain.tld — set as a Coolify env var,
#   never hardcoded in docker-compose.coolify.yaml (that would bake one tenant's domain into
#   a repo meant to be reusable by any tenant deploying this same app)
APP_URL=http://localhost:5678

# Required in both standalone and Coolify use — generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme
N8N_RUNNERS_AUTH_TOKEN=changeme

# Coolify-only, additionally required alongside VALKEY_PASSWORD above: the shared Valkey ACL
# user's username (see README's "Database and queue" section for how this user is
# provisioned). Not used by the standalone file, which authenticates to its own bundled
# Valkey with just VALKEY_PASSWORD and the instance's default user.
VALKEY_USERNAME=n8n_user
