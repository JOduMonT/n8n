# Standalone use (docker-compose.yaml, bundled Postgres + Valkey) — safe defaults, override as needed:
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=n8n
POSTGRES_DB=n8n
VALKEY_PASSWORD=n8n

# Required in both standalone and Coolify use — no default, deploy fails loudly without it:
# - Standalone: http://localhost:5678
# - Coolify: the real public domain, e.g. https://sub.domain.tld — set as a Coolify env var,
#   never hardcoded in docker-compose.coolify.yaml (that would bake one tenant's domain into
#   a repo meant to be reusable by any tenant deploying this same app)
APP_URL=http://localhost:5678

# Required in both standalone and Coolify use — generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme
N8N_RUNNERS_AUTH_TOKEN=changeme

# Coolify-only: the shared Valkey ACL user's own credentials (see README's "Database and
# queue" section for how this user is provisioned). Not used by the standalone file, which
# authenticates to its own bundled Valkey with just VALKEY_PASSWORD above.
VALKEY_USERNAME=n8n_user
